# Copy this file to .env and set the values for your PostgreSQL server.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=daymark_development
PGTESTDATABASE=daymark_test

# Production on EC2: use the instance role instead of PGPASSWORD.
# PG_AUTH_MODE=iam
# AWS_REGION=us-east-1
# PGUSER=daymark_iam
# PGSSLROOTCERT=/rails/config/certs/rds-global-bundle.pem
# Optional production read replica in the same AWS Region. Keep PGHOST as primary.
# PGREPLICAHOST=mydbreplica.cmv8swiq63ji.us-east-1.rds.amazonaws.com

# Optional shared production cache: ElastiCache for Valkey or Redis OSS.
# Use the writable primary endpoint, not the reader endpoint.
# rediss:// enables TLS; redis:// is only for caches with TLS disabled.
# REDIS_CACHE_URL=rediss://your-cache-primary-endpoint:6379
# Optional ACL username and password/AUTH token (never an RDS IAM token).
# REDIS_CACHE_USERNAME=default
# REDIS_CACHE_PASSWORD=replace-with-cache-password
